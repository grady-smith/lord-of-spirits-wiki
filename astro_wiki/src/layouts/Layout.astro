---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Lord of Spirits Wiki",
  description = "Explore the theology of enchantment, the unseen realm, and Orthodox Christian tradition through our fully interconnected Knowledge Graph."
} = Astro.props;
---

<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;800&family=Outfit:wght@400;500;700;800&display=swap" rel="stylesheet">
  
  <ClientRouter />
</head>
<body>
  
  <nav class="site-nav">
    <div class="container site-nav__inner">
      <a href="/" class="site-nav__brand">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="site-nav__logo">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linejoin="round"/>
        </svg>
        <span class="site-nav__title">Lord of Spirits</span>
      </a>
      <div class="site-nav__links">
        <a href="/" class="site-nav__link">Home</a>
        <!-- We can add Search or other links here later -->
      </div>
    </div>
  </nav>

  <div class="layout-content">
    <slot />
  </div>

  <footer class="site-footer container">
    <div class="site-footer__inner">
      <p>&copy; {new Date().getFullYear()} Lord of Spirits Wiki. A community project.</p>
    </div>
  </footer>

</body>
</html>
